# DealerOS Backend Environment Configuration Example (Render / Production)

# Django Secret Key (generate a strong random secret key for production)
SECRET_KEY=your-production-secret-key-here

# Debug Mode (False in production)
DEBUG=False

# Allowed Hosts (comma-separated list, or leave blank to default to .onrender.com, localhost, 127.0.0.1)
ALLOWED_HOSTS=your-app-name.onrender.com,localhost,127.0.0.1

# CORS Allowed Origins (comma-separated list for deployed Vercel frontend)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# CSRF Trusted Origins (comma-separated list)
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com,https://your-frontend.vercel.app

# Optional: Custom Data Directory for CSV Importer
# DATA_DIR=/path/to/data
